# cp .env.example .env 로 복사해서 쓰세요. .env는 커밋하지 않습니다.

# 백엔드가 X-Cueanda-Secret 헤더에 넣어 보내는 값.
# 설정하지 않으면 서버가 dummy-secret을 쓰고 기동 시 경고를 남깁니다.
# AI_MODE가 dummy가 아니면 이 값이 없을 때 아예 기동에 실패합니다.
CUEANDA_SHARED_SECRET=dummy-secret

# dummy  질문 텍스트가 고정 문장. LLM을 부르지 않아 요금이 들지 않습니다
# llm    이력서를 읽고 주질문을 실제로 생성합니다. ANTHROPIC_API_KEY가 필요합니다
AI_MODE=dummy

# 전사만 따로 켭니다. AI_MODE가 dummy여도 답변 오디오를 실제로 전사합니다.
# Whisper는 우리 GPU에서 돌아 요금이 없으므로, LLM을 켜지 않고도
# STT 통합을 확인할 수 있습니다. GPU와 faster-whisper가 필요합니다.
#
#   dummy                전사 안 함. 백엔드가 쓰는 기본값
#   dummy + USE_STT=1    전사만 함. 질문은 고정 문장. 요금 0원
#   llm                  전사도 하고 질문도 생성. 세션당 약 113원
USE_STT=

# faster-whisper 설정. GPU가 없으면 STT_DEVICE=cpu로 두세요 (많이 느립니다)
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16

# 질문을 음성으로 만듭니다. ai/tts.py가 있어야 하고, 외부 API를 부르므로
# Claude와는 별개로 요금이 붙습니다. 켜기 전에 단가를 확인하세요.
# 꺼져 있으면 샘플 mp3 하나가 고정으로 나갑니다.
# 합성이 실패하면 audio_url이 null로 나가고 질문 텍스트는 그대로 갑니다.
USE_TTS=

# 세션과 작업을 어디에 보관할지.
# 비워 두면 프로세스 메모리를 씁니다. 그러면 워커가 하나여야 하고,
# 서버를 재시작하면 진행 중이던 세션이 사라집니다.
# docker compose로 띄우면 자동으로 redis://redis:6379/0이 들어갑니다.
REDIS_URL=

# 폴링을 몇 번 해야 done이 되는가. 0이면 즉시 done.
# 백엔드 폴링 루프를 검증하려면 2~3으로 올리세요. dummy 모드에서만 쓰입니다.
DUMMY_POLL_TICKS=0

# ---------------------------------------------------------------------------
# AI_MODE=llm 일 때만 필요합니다
# ---------------------------------------------------------------------------

# console.anthropic.com → API Keys 에서 발급.
# Settings → Limits 에서 월 지출 한도를 함께 걸어두세요.
ANTHROPIC_API_KEY=

# claude-sonnet-5    기본. 질문 생성에는 이걸로 충분합니다
# claude-opus-5      품질이 아쉬울 때
# claude-haiku-4-5   배선만 확인할 때
LLM_MODEL=claude-sonnet-5

# low | medium | high
# thinking 토큰이 출력 요금으로 과금되므로 비용을 가장 크게 좌우합니다.
LLM_EFFORT=medium
